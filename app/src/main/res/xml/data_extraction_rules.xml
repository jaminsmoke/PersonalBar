<?xml version="1.0" encoding="utf-8"?><!--
    Reglas de extracción para API 31+ (cloud-backup y device-transfer): la BD
    del nodo se excluye por completo. Bar es un puesto estático; los datos
    canónicos vienen de Identity y la BD local (bearer cifrado, PII, comandas
    del turno) no debe viajar ni a la nube ni a otro dispositivo.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="personalbar.db" />
        <exclude domain="database" path="personalbar.db-wal" />
        <exclude domain="database" path="personalbar.db-shm" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="personalbar.db" />
        <exclude domain="database" path="personalbar.db-wal" />
        <exclude domain="database" path="personalbar.db-shm" />
    </device-transfer>
</data-extraction-rules>
